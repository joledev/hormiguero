# Plantilla de variables de entorno. ESTE archivo SI se versiona; dice QUE
# variables hacen falta, nunca sus valores reales.
#
#   cp .env.example .env
#   mix phx.gen.secret          # pega el resultado en SECRET_KEY_BASE
#   # y cambia POSTGRES_PASSWORD por una de verdad
#
# El .env real lo ignora .gitignore y no debe salir de tu maquina.

